# Local development only. `npm run setup` writes random credentials to .env.
APP_ENV=development
HTTP_PORT=8080
STOREFRONT_HOST=localhost
ADMIN_HOST=admin.localhost
SITE_URL=http://localhost:8080
POSTGRES_DB=bee
POSTGRES_USER=bee
POSTGRES_PASSWORD=replace-with-random-value
REDIS_PASSWORD=replace-with-random-value
MINIO_ROOT_USER=bee-local
MINIO_ROOT_PASSWORD=replace-with-random-value
S3_BUCKET=bee-media
S3_ACCESS_KEY=bee-media-app
S3_SECRET_KEY=replace-with-random-value
S3_REGION=us-east-1
ADMIN_ORIGIN=http://admin.localhost:8080
# API and worker config is mapped by Compose to internal service addresses.
