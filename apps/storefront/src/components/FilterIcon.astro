---
interface Props {
  /** reset — круговая стрелка, sliders — ползунки фильтров, clear — крестик. */
  name: 'reset' | 'sliders' | 'clear';
}
const { name } = Astro.props;
---

<svg
  class:list={['icon', `icon-${name}`]}
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'reset' && (
    <>
      <path d="M4.5 12a7.5 7.5 0 1 0 2.3-5.4" />
      <path d="M4.5 4.5v4h4" />
    </>
  )}
  {name === 'sliders' && (
    <>
      <path d="M4 7h16M4 12h16M4 17h16" />
      <circle class="knob" cx="8" cy="7" r="2.3" />
      <circle class="knob" cx="15.5" cy="12" r="2.3" />
      <circle class="knob" cx="10" cy="17" r="2.3" />
    </>
  )}
  {name === 'clear' && <path d="M7 7l10 10M17 7L7 17" />}
</svg>
