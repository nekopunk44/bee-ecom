---
import type { Locale } from '../i18n';
import HexMark from './HexMark.astro';
import { FAVORITES_COOKIE, parseFavorites } from '../lib/favorites';
interface Props {
  locale: Locale;
  /** night — графитовая шапка над тёмным первым экраном главной, paper — светлая над
   * светлыми страницами, чтобы между шапкой и страницей не было резкой границы. */
  tone?: 'night' | 'paper';
}
const { locale, tone = 'paper' } = Astro.props;
const suffix = Astro.url.pathname.replace(/^\/(ru|ro)/, '');
const query = Astro.url.searchParams.get('q') ?? '';
const favorites = parseFavorites(
  Astro.cookies.get(FAVORITES_COOKIE)?.value,
).length;
const text = {
  ru: {
    skip: 'Перейти к содержимому',
    search: 'Поиск по каталогу',
    account: 'Аккаунт',
    favorites: 'Избранное',
    cart: 'Корзина',
    language: 'Язык сайта',
  },
  ro: {
    skip: 'Salt la conținut',
    search: 'Căutare în catalog',
    account: 'Cont',
    favorites: 'Favorite',
    cart: 'Coș',
    language: 'Limba site-ului',
  },
}[locale];
---

<a class="skip-link" href="#main">
  {text.skip}
</a>
<header data-tone={tone}>
  <div class="container bar">
    <a class="brand" href={`/${locale}/`}>
      <HexMark size={30} />
      <span>bee</span>
    </a>
    <form
      class="search"
      role="search"
      method="get"
      action={`/${locale}/catalog/`}
    >
      <label for="site-search" class="visually-hidden">
        {text.search}
      </label>
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M20 20l-4-4"></path>
      </svg>
      <input
        id="site-search"
        type="search"
        name="q"
        value={query}
        maxlength="200"
        placeholder={text.search}
      />
    </form>
    <div class="actions">
      <a
        class="icon favorites"
        href={`/${locale}/favorites/`}
        aria-label={text.favorites}
        data-favorites-link
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 20.5s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.7c0 5.6-7.5 10.2-7.5 10.2z"></path>
        </svg>
        <b data-favorites-count hidden={favorites === 0}>
          {favorites}
        </b>
      </a>
      <a class="icon" href={`/${locale}/account/`} aria-label={text.account}>
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path>
        </svg>
      </a>
      <a class="cart" href={`/${locale}/cart/`} data-cart-link>
        <span class="drop" aria-hidden="true"></span>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          aria-hidden="true"
        >
          <path d="M3 4h2l2.4 11h11l2-8H6.2"></path>
          <circle cx="9" cy="20" r="1.5"></circle>
          <circle cx="18" cy="20" r="1.5"></circle>
        </svg>
        <span class="cart-label">{text.cart}</span>
      </a>
      <nav class="languages" aria-label={text.language}>
        <a
          href={`/ru${suffix}`}
          lang="ru"
          aria-current={locale === 'ru' ? 'page' : undefined}
        >
          RU
        </a>
        <a
          href={`/ro${suffix}`}
          lang="ro"
          aria-current={locale === 'ro' ? 'page' : undefined}
        >
          RO
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  // Число на сердечке в шапке меняется сразу, как только товар отмечен в карточке.
  document.addEventListener('bee:favorites', (event) => {
    const total = (event as CustomEvent<number>).detail;
    const badge = document.querySelector<HTMLElement>('[data-favorites-count]');
    if (!badge) return;
    badge.textContent = String(total);
    badge.hidden = total === 0;
    badge.classList.remove('bump');
    requestAnimationFrame(() => badge.classList.add('bump'));
  });
</script>

<style>
  /* Шапка в цвет страницы: светлая над светлыми страницами, графитовая над тёмным
     первым экраном главной. Цвета внутри берутся из переменных ниже. */
  header {
    --header-text: var(--color-ink);
    --header-muted: var(--color-muted);
    --header-raised: var(--color-sand);
    background: var(--color-paper);
    color: var(--header-text);
    /* При переходе между страницами шапка стоит на месте, меняется только содержимое. */
    view-transition-name: site-header;
  }
  header[data-tone='night'] {
    --header-text: #ffffff;
    --header-muted: var(--color-night-muted);
    --header-raised: var(--color-night-raised);
    --color-focus: var(--color-honey);
    background: var(--color-night);
  }
  /* Сота в логотипе поворачивается на грань — соты симметричны, поэтому это игра, а не смена знака. */
  .brand :global(svg) {
    transition: transform var(--motion-slow) var(--ease-spring);
  }
  .brand:hover :global(svg) {
    transform: rotate(60deg);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
    padding-block: var(--space-md);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    text-decoration: none;
  }
  .search {
    flex: 1 1 16rem;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 3rem;
    padding-inline: 1rem;
    border-radius: var(--radius-pill);
    background: var(--header-raised);
    color: var(--header-muted);
  }
  .search:focus-within {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .search input {
    flex: 1;
    padding: 0.6rem 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--header-text);
    outline: none;
  }
  .search input::placeholder {
    color: var(--header-muted);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-left: auto;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
  }
  .icon:hover {
    background: var(--header-raised);
  }
  .favorites {
    position: relative;
  }
  .favorites b {
    position: absolute;
    top: 0.1rem;
    right: 0.05rem;
    display: grid;
    place-items: center;
    min-width: 1.15rem;
    height: 1.15rem;
    padding-inline: 0.25rem;
    border-radius: var(--radius-pill);
    background: var(--color-honey);
    color: var(--color-ink);
    font-size: 0.6875rem;
    font-weight: 800;
    line-height: 1;
  }
  .favorites b[hidden] {
    display: none;
  }
  .favorites b.bump {
    animation: badge-bump 420ms var(--ease-standard);
  }
  @keyframes badge-bump {
    40% {
      scale: 1.4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .favorites b.bump {
      animation: none;
    }
  }
  .cart {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 1.1rem;
    border-radius: var(--radius-pill);
    background: var(--color-honey);
    color: var(--color-ink);
    font-weight: 700;
    text-decoration: none;
    transition: background var(--motion-fast) var(--ease-standard);
  }
  .cart:hover {
    background: #e6ab00;
  }
  /* При наведении в тележку падает графитовая ячейка, тележка её ловит и качается. */
  .drop {
    position: absolute;
    top: 0.2rem;
    left: calc(1.1rem + 10px);
    width: 0.45rem;
    height: 0.52rem;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: var(--color-ink);
    opacity: 0;
    translate: -50% 0;
    pointer-events: none;
  }
  .cart svg {
    transform-origin: 40% 90%;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .cart:hover .drop {
      animation: cell-drop 760ms var(--ease-standard) both;
    }
    .cart:hover svg {
      animation: cart-catch 760ms var(--ease-standard) both;
    }
  }
  @keyframes cell-drop {
    0% {
      opacity: 0;
      translate: -50% -0.4rem;
    }
    20% {
      opacity: 1;
    }
    55% {
      opacity: 1;
      translate: -50% 0.7rem;
    }
    62%,
    100% {
      opacity: 0;
      translate: -50% 0.7rem;
    }
  }
  @keyframes cart-catch {
    0%,
    52% {
      rotate: 0deg;
      translate: 0 0;
    }
    64% {
      rotate: -10deg;
      translate: 0 2px;
    }
    80% {
      rotate: 5deg;
      translate: 0 0;
    }
    100% {
      rotate: 0deg;
    }
  }
  .languages {
    display: flex;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .languages a {
    padding: 0.5rem 0.45rem;
    color: var(--header-muted);
    text-decoration: none;
  }
  .languages a:hover {
    color: var(--header-text);
  }
  .languages a[aria-current] {
    color: var(--header-text);
    text-decoration: underline;
    text-decoration-color: var(--color-honey);
    text-decoration-thickness: 2px;
  }
  /* На телефоне: логотип и кнопки в первой строке, поиск во второй. */
  @media (max-width: 47.99rem) {
    .bar {
      display: grid;
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        'brand . actions'
        'search search search';
      gap: var(--space-sm);
    }
    .brand {
      grid-area: brand;
    }
    .search {
      grid-area: search;
      min-width: 0;
    }
    /* Четыре значка и языки должны уместиться рядом с логотипом даже на 360 px. */
    .actions {
      grid-area: actions;
      gap: 0.15rem;
    }
    .icon {
      width: 2.5rem;
      height: 2.5rem;
    }
    .cart {
      width: 2.5rem;
      min-height: 2.5rem;
      padding: 0;
      justify-content: center;
    }
    .languages a {
      padding-inline: 0.3rem;
    }
    .drop {
      left: 50%;
    }
    .cart-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
