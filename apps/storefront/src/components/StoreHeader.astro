---
import type { Locale } from '../i18n';
import { catalogText } from '../lib/catalog';
import HexMark from './HexMark.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const suffix = Astro.url.pathname.replace(/^\/(ru|ro)/, '');
const query = Astro.url.searchParams.get('q') ?? '';
const text = {
  ru: {
    skip: 'Перейти к содержимому',
    nav: 'Навигация',
    search: 'Поиск по каталогу',
    account: 'Аккаунт',
    cart: 'Корзина',
    language: 'Язык сайта',
  },
  ro: {
    skip: 'Salt la conținut',
    nav: 'Navigare',
    search: 'Căutare în catalog',
    account: 'Cont',
    cart: 'Coș',
    language: 'Limba site-ului',
  },
}[locale];
---

<a class="skip-link" href="#main">
  {text.skip}
</a>
<header>
  <div class="container bar">
    <a class="brand" href={`/${locale}/`}>
      <HexMark size={30} />
      <span>bee</span>
    </a>
    <nav class="sections" aria-label={text.nav}>
      <a href={`/${locale}/catalog/`}>{catalogText[locale].catalog}</a>
    </nav>
    <form
      class="search"
      role="search"
      method="get"
      action={`/${locale}/catalog/`}
    >
      <label for="site-search" class="visually-hidden">
        {text.search}
      </label>
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M20 20l-4-4"></path>
      </svg>
      <input
        id="site-search"
        type="search"
        name="q"
        value={query}
        maxlength="200"
        placeholder={text.search}
      />
    </form>
    <div class="actions">
      <a class="icon" href={`/${locale}/account/`} aria-label={text.account}>
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path>
        </svg>
      </a>
      <a class="cart" href={`/${locale}/cart/`} data-cart-link>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          aria-hidden="true"
        >
          <path d="M3 4h2l2.4 11h11l2-8H6.2"></path>
          <circle cx="9" cy="20" r="1.5"></circle>
          <circle cx="18" cy="20" r="1.5"></circle>
        </svg>
        <span class="cart-label">{text.cart}</span>
      </a>
      <nav class="languages" aria-label={text.language}>
        <a
          href={`/ru${suffix}`}
          lang="ru"
          aria-current={locale === 'ru' ? 'page' : undefined}
        >
          RU
        </a>
        <a
          href={`/ro${suffix}`}
          lang="ro"
          aria-current={locale === 'ro' ? 'page' : undefined}
        >
          RO
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  header {
    background: var(--color-night);
    color: #ffffff;
    --color-focus: var(--color-honey);
    /* При переходе между страницами шапка стоит на месте, меняется только содержимое. */
    view-transition-name: site-header;
  }
  /* Сота в логотипе поворачивается на грань — соты симметричны, поэтому это игра, а не смена знака. */
  .brand :global(svg) {
    transition: transform var(--motion-slow) var(--ease-spring);
  }
  .brand:hover :global(svg) {
    transform: rotate(60deg);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
    padding-block: var(--space-md);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    text-decoration: none;
  }
  .sections {
    display: flex;
    gap: var(--space-md);
    font-weight: 600;
  }
  .sections a {
    padding-block: var(--space-xs);
    text-decoration: none;
  }
  .sections a:hover {
    color: var(--color-honey);
  }
  .search {
    flex: 1 1 16rem;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 3rem;
    padding-inline: 1rem;
    border-radius: var(--radius-pill);
    background: var(--color-night-raised);
    color: var(--color-night-muted);
  }
  .search:focus-within {
    outline: 3px solid var(--color-honey);
    outline-offset: 2px;
  }
  .search input {
    flex: 1;
    padding: 0.6rem 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #ffffff;
    outline: none;
  }
  .search input::placeholder {
    color: var(--color-night-muted);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-left: auto;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
  }
  .icon:hover {
    background: var(--color-night-raised);
  }
  .cart {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 1.1rem;
    border-radius: var(--radius-pill);
    background: var(--color-honey);
    color: var(--color-ink);
    font-weight: 700;
    text-decoration: none;
  }
  .languages {
    display: flex;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .languages a {
    padding: 0.5rem 0.45rem;
    color: var(--color-night-muted);
    text-decoration: none;
  }
  .languages a:hover {
    color: #ffffff;
  }
  .languages a[aria-current] {
    color: #ffffff;
    text-decoration: underline;
    text-decoration-color: var(--color-honey);
    text-decoration-thickness: 2px;
  }
  /* На телефоне: логотип и кнопки в первой строке, каталог и поиск во второй. */
  @media (max-width: 47.99rem) {
    .bar {
      display: grid;
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        'brand . actions'
        'sections search search';
      gap: var(--space-sm);
    }
    .brand {
      grid-area: brand;
    }
    .sections {
      grid-area: sections;
    }
    .search {
      grid-area: search;
      min-width: 0;
    }
    .actions {
      grid-area: actions;
      gap: var(--space-xs);
    }
    .cart {
      width: 2.75rem;
      padding: 0;
      justify-content: center;
    }
    .cart-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
