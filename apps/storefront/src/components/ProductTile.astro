---
import { money, catalogText, type Product } from '../lib/catalog';
import type { Locale } from '../i18n';
import HexMark from './HexMark.astro';
interface Props {
  product: Product;
  locale: Locale;
}
/* Компактная карточка для тёмной полосы главной: фото, название и цена в одну строку,
   чтобы несколько новинок помещались рядом со сценой. */
const { product, locale } = Astro.props;
const translation = product.translations[locale];
const image = product.images[0];
const prices = product.variants
  .filter((v) => v.active)
  .map((v) => v.priceMinor);
const price = Math.min(...prices);
const several = new Set(prices).size > 1;
---

<a class="tile" href={`/${locale}/catalog/${product.slug}/`}>
  <span class:list={['thumb', { empty: !image }]}>
    {image ? (
      <img
        src={image.url}
        srcset={image.srcSet}
        sizes="96px"
        alt=""
        width="640"
        height="640"
        loading="lazy"
      />
    ) : (
      <HexMark size={28} />
    )}
  </span>
  <span class="text">
    <span class="name">{translation.name}</span>
    <span class="price">
      {several && <span>{catalogText[locale].from} </span>}
      {money(price, locale)}
    </span>
  </span>
</a>

<style>
  .tile {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    height: 100%;
    padding: 0.6rem;
    border: 1px solid var(--color-night-line);
    border-radius: var(--radius-md);
    background: rgb(42 39 32 / 0.88);
    color: #ffffff;
    text-decoration: none;
    transition:
      transform var(--motion-normal) var(--ease-out),
      border-color var(--motion-normal) var(--ease-out);
  }
  .tile:hover {
    transform: translateY(-3px);
    border-color: var(--color-honey);
  }
  .tile:active {
    transform: translateY(-1px) scale(0.99);
  }
  .thumb {
    flex: none;
    display: grid;
    place-items: center;
    width: 5.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-sand);
    color: var(--color-ink);
  }
  .thumb.empty {
    background: var(--color-honey-soft);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .text {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }
  .name {
    display: -webkit-box;
    overflow: hidden;
    font-weight: 600;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  .price {
    color: var(--color-honey);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
</style>
