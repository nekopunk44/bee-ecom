---
type PartLabel = { name: string; detail: string };
interface Props {
  labels: PartLabel[];
}
const { labels } = Astro.props;
---

<canvas class="scene" data-story-canvas></canvas>
<div class="parts" data-story-parts>
  {labels.map((label) => (
    <span class="part" data-part>
      <span class="part-text">
        <span>{label.name}</span>
        <small>{label.detail}</small>
      </span>
    </span>
  ))}
</div>

<script>
  import { reducedMotion } from '../lib/motion';

  /* 3D-история главной. three.js грузится отдельным файлом, когда браузер свободен, и
     только если сцену можно показать: без JavaScript, при «уменьшить движение»,
     экономии трафика или без WebGL остаётся обычный первый экран с картинкой. */
  function start() {
    const story = document.querySelector<HTMLElement>('[data-story]');
    const stage = story?.querySelector<HTMLElement>('[data-story-stage]');
    const canvas = stage?.querySelector<HTMLCanvasElement>(
      '[data-story-canvas]',
    );
    const connection = (
      navigator as Navigator & { connection?: { saveData?: boolean } }
    ).connection;
    if (!story || !stage || !canvas) return;
    if (reducedMotion() || connection?.saveData) return;
    const parts = [...stage.querySelectorAll<HTMLElement>('[data-part]')];
    const steps = [...story.querySelectorAll<HTMLElement>('.story-step')];
    let stop: (() => void) | null = null;
    const end = () => {
      stop?.();
      stop = null;
      story.classList.remove('story--live');
    };
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    motion.addEventListener('change', () => {
      if (motion.matches) end();
    });
    import('../lib/hive-story/scene')
      .then(({ startHiveStory }) => {
        story.classList.add('story--live');
        stop = startHiveStory({
          story,
          steps,
          stage,
          canvas,
          labels: parts,
          onLost: end,
        });
        if (!stop) story.classList.remove('story--live');
      })
      .catch(() => story.classList.remove('story--live'));
  }

  if ('requestIdleCallback' in window)
    requestIdleCallback(start, { timeout: 1500 });
  else setTimeout(start, 200);
</script>

<style>
  .scene,
  .parts {
    position: absolute;
    inset: 0;
  }
  .scene {
    display: block;
    width: 100%;
    height: 100%;
  }
  .parts {
    pointer-events: none;
  }
  /* Подписи частей улья: сцена каждый кадр ставит их рядом с частью. */
  .part {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    will-change: transform, opacity;
  }
  .part::before {
    content: '';
    width: 2.25rem;
    height: 1px;
    background: var(--color-honey);
  }
  .part-text {
    display: grid;
  }
  .part small {
    color: var(--color-honey);
    font-size: 0.75rem;
  }
  @media (max-width: 47.99rem) {
    .part {
      font-size: 0.75rem;
    }
    .part::before {
      width: 1rem;
    }
  }
</style>
