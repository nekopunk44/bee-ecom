---
/* Живые соты для пустых состояний на страницах без островков (см. lib/comb-field). */
---

<canvas class="comb" aria-hidden="true" data-comb-field></canvas>

<script>
  import { mountCombField } from '../lib/comb-field';

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>(
    'canvas[data-comb-field]',
  ))
    mountCombField(canvas);
</script>

<style>
  /* Цвет пустых ячеек: чуть темнее медово-светлого фона пустого результата. */
  .comb {
    display: block;
    width: 100%;
    height: 9rem;
    border-radius: var(--radius-sm);
    color: #fbe3a0;
    touch-action: pan-y;
  }
</style>
