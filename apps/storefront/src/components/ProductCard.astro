---
import { money, catalogText, type Product } from '../lib/catalog';
import { FAVORITES_COOKIE, parseFavorites } from '../lib/favorites';
import type { Locale } from '../i18n';
import HexMark from './HexMark.astro';
interface Props {
  product: Product;
  locale: Locale;
  /** На главной карточки стоят под заголовком раздела, поэтому их заголовок третьего уровня. */
  level?: 2 | 3;
  /** Проявляться при прокрутке (на главной и в каталоге). */
  reveal?: boolean;
}
const { product, locale, level = 2, reveal = false } = Astro.props;
const t = catalogText[locale];
const Heading = level === 3 ? 'h3' : 'h2';
const translation = product.translations[locale];
const href = `/${locale}/catalog/${product.slug}/`;
const images = product.images;
const variants = product.variants.filter((v) => v.active);
const prices = variants.map((v) => v.priceMinor);
const price = Math.min(...prices);
const several = new Set(prices).size > 1;
const saved = parseFavorites(
  Astro.cookies.get(FAVORITES_COOKIE)?.value,
).includes(product.slug);
---

<article class="card" data-card data-reveal={reveal || undefined}>
  <a href={href} aria-label={translation.name}>
    <div
      class:list={['picture', { empty: !images.length }]}
      data-transition-name={`product-${product.slug}`}
      data-tilt
      data-gallery={images.length > 1 ? '' : undefined}
    >
      {images.length ? (
        <div class="track">
          {images.map((image, index) => (
            <img
              src={image.url}
              srcset={image.srcSet}
              sizes="(min-width: 75rem) 300px, (min-width: 48rem) 45vw, 90vw"
              alt={index === 0 ? translation.name : ''}
              width="640"
              height="640"
              loading="lazy"
              draggable="false"
            />
          ))}
        </div>
      ) : (
        <span class="placeholder">
          <HexMark size={44} />
          {t.noImage}
        </span>
      )}
      {images.length > 1 && (
        <span class="dots" aria-hidden="true">
          {images.map((_, index) => (
            <span data-current={index === 0 ? '' : undefined} />
          ))}
        </span>
      )}
    </div>
    <Heading>{translation.name}</Heading>
  </a>
  <button
    class="favorite"
    type="button"
    data-favorite={product.slug}
    data-label-add={t.favorite}
    data-label-remove={t.unfavorite}
    aria-pressed={saved ? 'true' : 'false'}
    aria-label={saved ? t.unfavorite : t.favorite}
  >
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 20.5s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.7c0 5.6-7.5 10.2-7.5 10.2z"></path>
    </svg>
    <span class="burst" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
      <i></i>
      <i></i>
      <i></i>
    </span>
  </button>
  {variants.length > 1 && (
    <div class="variants" data-variants hidden>
      <p>{t.chooseVariant}</p>
      {variants.map((variant) => (
        <button type="button" data-variant-choice={variant.id}>
          <span>{variant.name}</span>
          <b>{money(variant.priceMinor, locale)}</b>
        </button>
      ))}
    </div>
  )}
  <div class="buy">
    <p class="price">
      {several && <span>{t.from}</span>}
      {money(price, locale)}
    </p>
    {variants.length > 0 && (
      <button
        class="to-cart"
        type="button"
        data-to-cart
        data-variant={variants.length === 1 ? variants[0]?.id : undefined}
        data-locale={locale}
        data-failed={t.addFailed}
        data-limit={t.cartLimit}
        aria-label={t.addToCart}
        aria-expanded={variants.length > 1 ? 'false' : undefined}
      >
        <svg
          class="icon-cart"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M3 4h2l2.4 11h11l2-8H6.2"></path>
          <circle cx="9" cy="20" r="1.5"></circle>
          <circle cx="18" cy="20" r="1.5"></circle>
        </svg>
        <svg
          class="icon-check"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M5 12.5l4.5 4.5L19 7.5"></path>
        </svg>
      </button>
    )}
  </div>
  <p class="note" data-card-note role="status"></p>
</article>
<script>
  import { enableTilt } from '../lib/motion';
  import { enableCards } from '../lib/card-actions';
  enableTilt();
  enableCards();
</script>
<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .card > a {
    text-decoration: none;
  }
  .picture {
    position: relative;
    transform: perspective(50rem) rotateX(var(--tilt-x, 0deg))
      rotateY(var(--tilt-y, 0deg));
    transition:
      transform 180ms var(--ease-out),
      box-shadow var(--motion-normal) var(--ease-out);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-sand);
    color: var(--color-muted);
  }
  .picture.empty {
    background: var(--color-honey-soft);
  }
  .placeholder {
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  /* Фото лежат в ряд: пальцем листаются с привязкой к кадру, мышью — по положению курсора. */
  .track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  img {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    scroll-snap-align: start;
    transition: transform var(--motion-normal) var(--ease-standard);
  }
  a:hover img {
    transform: scale(1.05);
  }
  /* Точки под фото: текущая вытягивается в медовую капсулу. */
  .dots {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    display: flex;
    gap: 0.3rem;
    padding: 0.3rem 0.45rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 75%);
    translate: -50% 0;
  }
  .dots span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-pill);
    background: rgb(23 21 15 / 30%);
    transition:
      width var(--motion-normal) var(--ease-standard),
      background var(--motion-normal) var(--ease-standard);
  }
  .dots span[data-current] {
    width: 1rem;
    background: var(--color-honey);
  }
  /* Блик идёт за курсором (координаты ставит enableTilt из lib/motion). */
  .picture::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      circle at var(--glare-x, 50%) var(--glare-y, 0%),
      rgb(255 255 255 / 55%),
      rgb(255 255 255 / 0%) 55%
    );
    opacity: 0;
    transition: opacity var(--motion-normal) var(--ease-out);
    pointer-events: none;
  }
  a:hover .picture::after {
    opacity: 1;
  }
  /* Карточка приподнимается и наклоняется за указателем, при нажатии чуть проседает. */
  a:hover .picture {
    transform: perspective(50rem) translateY(-4px) rotateX(var(--tilt-x, 0deg))
      rotateY(var(--tilt-y, 0deg));
    box-shadow: 0 1rem 2rem rgb(23 21 15 / 12%);
  }
  a:active .picture {
    transform: translateY(-1px) scale(0.99);
    transition-duration: var(--motion-fast);
  }
  h2,
  h3 {
    margin: var(--space-md) 0 var(--space-xs);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }
  a:hover :is(h2, h3) {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  /* Сердечко в углу фото: при сохранении наливается мёдом, вокруг разлетаются ячейки. */
  .favorite {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 85%);
    color: var(--color-ink);
    box-shadow: var(--shadow-soft);
    transition: scale var(--motion-fast) var(--ease-standard);
  }
  .favorite:hover {
    scale: 1.08;
  }
  .favorite:active {
    scale: 0.92;
  }
  .favorite path {
    fill: transparent;
    stroke: currentcolor;
    stroke-width: 2;
    stroke-linejoin: round;
    transition: fill var(--motion-normal) var(--ease-standard);
  }
  .favorite[aria-pressed='true'] path {
    fill: var(--color-honey);
  }
  .favorite.pop svg {
    animation: heart-pop 480ms var(--ease-standard);
  }
  .burst {
    position: absolute;
    inset: 50% auto auto 50%;
    pointer-events: none;
  }
  .burst i {
    position: absolute;
    width: 0.4rem;
    height: 0.46rem;
    margin: -0.23rem 0 0 -0.2rem;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: var(--color-honey);
    opacity: 0;
  }
  .favorite.pop .burst i {
    animation: cell-burst 560ms var(--ease-out) both;
  }
  .burst i:nth-child(2) {
    --angle: 60deg;
  }
  .burst i:nth-child(3) {
    --angle: 120deg;
  }
  .burst i:nth-child(4) {
    --angle: 180deg;
  }
  .burst i:nth-child(5) {
    --angle: 240deg;
  }
  .burst i:nth-child(6) {
    --angle: 300deg;
  }
  @keyframes heart-pop {
    35% {
      scale: 1.35;
    }
    65% {
      scale: 0.9;
    }
  }
  /* Каждая ячейка летит по своему лучу: поворот на свой угол, потом сдвиг «вверх». */
  @keyframes cell-burst {
    from {
      opacity: 1;
      transform: rotate(var(--angle, 0deg)) translateY(0);
    }
    to {
      opacity: 0;
      transform: rotate(var(--angle, 0deg)) translateY(-1.4rem);
    }
  }

  .buy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: auto;
  }
  .price {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .price span {
    margin-right: 0.3em;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-muted);
  }
  /* «В корзину» — медовая круглая кнопка; после добавления на ней дорисовывается галочка. */
  .to-cart {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-honey);
    color: var(--color-ink);
    transition:
      background var(--motion-fast) var(--ease-standard),
      scale var(--motion-fast) var(--ease-standard);
  }
  .to-cart:hover {
    background: #e6ab00;
    scale: 1.06;
  }
  .to-cart:active {
    scale: 0.94;
  }
  .to-cart svg {
    grid-area: 1 / 1;
    fill: none;
    stroke: currentcolor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .to-cart .icon-check {
    display: none;
  }
  .to-cart[data-state='added'] {
    background: var(--color-ink);
    color: var(--color-honey);
  }
  .to-cart[data-state='added'] .icon-cart {
    display: none;
  }
  .to-cart[data-state='added'] .icon-check {
    display: block;
  }
  .to-cart[data-state='added'] .icon-check path {
    stroke-dasharray: 24;
    animation: draw 420ms var(--ease-out) both;
  }
  .to-cart[data-state='busy'] {
    animation: pending 900ms var(--ease-in-out) infinite;
  }
  .to-cart[aria-expanded='true'] {
    background: var(--color-ink);
    color: #ffffff;
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 24;
    }
  }
  @keyframes pending {
    50% {
      opacity: 0.6;
      scale: 0.94;
    }
  }
  /* Выбор варианта поднимается поверх фото. */
  .variants {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 3;
    display: grid;
    align-content: end;
    gap: 0.35rem;
    aspect-ratio: 1;
    padding: 0.75rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(
      to top,
      var(--color-sand) 55%,
      rgb(244 241 232 / 0%)
    );
    transition:
      opacity var(--motion-normal) var(--ease-standard),
      translate var(--motion-normal) var(--ease-standard);
  }
  .variants[hidden] {
    display: none;
  }
  @starting-style {
    .variants {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }
  .variants p {
    margin: 0 0 0.15rem;
    font-size: 0.875rem;
    font-weight: 700;
  }
  .variants button {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    min-height: 2.5rem;
    padding: 0.45rem 0.8rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: 0.9375rem;
    font-weight: 600;
    text-align: left;
    transition:
      background var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }
  .variants button:hover {
    background: var(--color-ink);
    color: #ffffff;
  }
  .variants b {
    white-space: nowrap;
  }
  .note {
    margin: var(--space-xs) 0 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-danger);
  }
  .note:empty {
    display: none;
  }
  .note :global(a) {
    color: var(--color-ink);
  }
  /* Без JavaScript кнопкам нечего делать: карточка остаётся ссылкой на товар. */
  @media (scripting: none) {
    .favorite,
    .to-cart {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .favorite,
    .to-cart,
    .dots span,
    .variants {
      transition: none;
    }
  }
  /* На телефоне карточки стоят в два столбца: заголовок и цена мельче. */
  @media (max-width: 47.99rem) {
    .picture,
    .variants {
      border-radius: var(--radius-md);
    }
    h2,
    h3 {
      margin-top: var(--space-sm);
      font-size: 1rem;
    }
    .price {
      font-size: 1.125rem;
    }
    .favorite {
      top: 0.4rem;
      right: 0.4rem;
      width: 2.25rem;
      height: 2.25rem;
    }
    .to-cart {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
