---
import { money, catalogText, type Product } from '../lib/catalog';
import type { Locale } from '../i18n';
import HexMark from './HexMark.astro';
interface Props {
  product: Product;
  locale: Locale;
  /** На главной карточки стоят под заголовком раздела, поэтому их заголовок третьего уровня. */
  level?: 2 | 3;
  /** Проявляться при прокрутке (на главной и в каталоге). */
  reveal?: boolean;
}
const { product, locale, level = 2, reveal = false } = Astro.props;
const Heading = level === 3 ? 'h3' : 'h2';
const translation = product.translations[locale];
const image = product.images[0];
const prices = product.variants
  .filter((v) => v.active)
  .map((v) => v.priceMinor);
const price = Math.min(...prices);
const several = new Set(prices).size > 1;
---

<article data-reveal={reveal || undefined}>
  <a href={`/${locale}/catalog/${product.slug}/`} aria-label={translation.name}>
    <div
      class:list={['picture', { empty: !image }]}
      style={`view-transition-name: product-${product.slug}`}
      data-tilt
    >
      {image ? (
        <img
          src={image.url}
          srcset={image.srcSet}
          sizes="(min-width: 75rem) 300px, (min-width: 48rem) 45vw, 90vw"
          alt={translation.name}
          width="640"
          height="640"
          loading="lazy"
        />
      ) : (
        <span class="placeholder">
          <HexMark size={44} />
          {catalogText[locale].noImage}
        </span>
      )}
    </div>
    <Heading>{translation.name}</Heading>
  </a>
  <p class="price">
    {several && <span>{catalogText[locale].from}</span>}
    {money(price, locale)}
  </p>
</article>
<script>
  import { enableTilt } from '../lib/motion';
  enableTilt();
</script>
<style>
  article {
    display: flex;
    flex-direction: column;
  }
  article a {
    text-decoration: none;
  }
  .picture {
    position: relative;
    transform: perspective(50rem) rotateX(var(--tilt-x, 0deg))
      rotateY(var(--tilt-y, 0deg));
    transition:
      transform 180ms var(--ease-out),
      box-shadow var(--motion-normal) var(--ease-out);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-sand);
    color: var(--color-muted);
  }
  .picture.empty {
    background: var(--color-honey-soft);
  }
  .placeholder {
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform var(--motion-normal) var(--ease-standard);
  }
  a:hover img {
    transform: scale(1.05);
  }
  /* Блик идёт за курсором (координаты ставит enableTilt из lib/motion). */
  .picture::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      circle at var(--glare-x, 50%) var(--glare-y, 0%),
      rgb(255 255 255 / 55%),
      rgb(255 255 255 / 0%) 55%
    );
    opacity: 0;
    transition: opacity var(--motion-normal) var(--ease-out);
    pointer-events: none;
  }
  a:hover .picture::after {
    opacity: 1;
  }
  /* Карточка приподнимается и наклоняется за указателем, при нажатии чуть проседает. */
  a:hover .picture {
    transform: perspective(50rem) translateY(-4px) rotateX(var(--tilt-x, 0deg))
      rotateY(var(--tilt-y, 0deg));
    box-shadow: 0 1rem 2rem rgb(23 21 15 / 12%);
  }
  a:active .picture {
    transform: translateY(-1px) scale(0.99);
    transition-duration: var(--motion-fast);
  }
  h2,
  h3 {
    margin: var(--space-md) 0 var(--space-xs);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }
  a:hover :is(h2, h3) {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .price {
    margin: auto 0 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .price span {
    margin-right: 0.3em;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-muted);
  }
  /* На телефоне карточки стоят в два столбца: заголовок и цена мельче. */
  @media (max-width: 47.99rem) {
    .picture {
      border-radius: var(--radius-md);
    }
    h2,
    h3 {
      margin-top: var(--space-sm);
      font-size: 1rem;
    }
    .price {
      font-size: 1.125rem;
    }
  }
</style>
