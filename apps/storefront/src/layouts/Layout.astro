---
import '@bee/ui/fonts.css';
import '@bee/ui/tokens.css';
import '@bee/ui/base.css';
import '@bee/ui/motion.css';
import { locales, type Locale } from '../i18n';
interface Props {
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
}
const { locale, title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const suffix = Astro.url.pathname.replace(/^\/(ru|ro)/, '');
const allowIndex = process.env.ENABLE_INDEXING === 'true' && !noindex;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/view-transition.js"></script>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={allowIndex ? 'index, follow' : 'noindex, follow'}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {locales.map((language) => (
      <link
        rel="alternate"
        hreflang={language}
        href={new URL(`/${language}${suffix}`, Astro.site)}
      />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      /* Запоминаем, откуда начался переход: из этой точки откроется каталог
         (public/view-transition.js на следующей странице). */
      function remember(x: number, y: number) {
        try {
          sessionStorage.setItem(
            'bee:transition',
            JSON.stringify({
              x: Math.round((x / innerWidth) * 100),
              y: Math.round((y / innerHeight) * 100),
              path: location.pathname,
              at: Date.now(),
            }),
          );
        } catch {
          // Без sessionStorage переход просто обычный.
        }
      }
      function center(element: Element) {
        const rect = element.getBoundingClientRect();
        return [
          rect.left + rect.width / 2,
          rect.top + rect.height / 2,
        ] as const;
      }
      document.addEventListener('click', (event) => {
        const link =
          event.target instanceof Element
            ? event.target.closest<HTMLAnchorElement>('a[href]')
            : null;
        if (!link || link.origin !== location.origin) return;
        // С клавиатуры координат нет: берём середину ссылки.
        const [x, y] =
          event.clientX || event.clientY
            ? [event.clientX, event.clientY]
            : center(link);
        remember(x, y);
      });
      document.addEventListener('submit', (event) => {
        if (event.target instanceof HTMLFormElement)
          remember(...center(event.target));
      });
    </script>
  </body>
</html>
<style is:global>
  /* Подвал прижат к низу даже на короткой странице, например в пустой корзине. */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  body > main {
    flex: 1 0 auto;
  }
</style>
