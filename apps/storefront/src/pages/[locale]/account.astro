---
import { isLocale } from '../../i18n';

// Отдельной страницы аккаунта нет: вход и меню покупателя — окно поверх страницы.
// Старый адрес и ссылка без JavaScript ведут на главную, где окно сразу открывается.
const locale = Astro.params.locale;
if (!isLocale(locale)) return Astro.redirect('/404');
return Astro.redirect(`/${locale}/?signin=open`);
---
