---
import Layout from '../../layouts/Layout.astro';
import StoreHeader from '../../components/StoreHeader.astro';
import CartWorkspace from '../../components/CartWorkspace.svelte';
import { isLocale } from '../../i18n';
const locale = Astro.params.locale;
if (!isLocale(locale)) return Astro.redirect('/404');
const title = locale === 'ru' ? 'Корзина' : 'Coș';
---

<Layout locale={locale} title={`${title} — Bee`} description={title} noindex>
  <StoreHeader locale={locale} />
  <main id="main" class="container">
    <CartWorkspace client:load locale={locale} />
  </main>
</Layout>

<style>
  main {
    padding-block: var(--space-lg) var(--space-xl);
  }
</style>
