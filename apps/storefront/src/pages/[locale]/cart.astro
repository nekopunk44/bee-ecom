---
import Layout from '../../layouts/Layout.astro';
import StoreHeader from '../../components/StoreHeader.astro';
import StoreFooter from '../../components/StoreFooter.astro';
import PageTop from '../../components/PageTop.astro';
import CartWorkspace from '../../components/CartWorkspace.svelte';
import { isLocale } from '../../i18n';
const locale = Astro.params.locale;
if (!isLocale(locale)) return Astro.redirect('/404');
const text = {
  ru: {
    title: 'Корзина',
    note: 'Отложенные товары хранятся в вашем аккаунте и видны с любого устройства.',
  },
  ro: {
    title: 'Coș',
    note: 'Produsele puse deoparte se păstrează în contul tău și se văd de pe orice dispozitiv.',
  },
}[locale];
---

<Layout
  locale={locale}
  title={`${text.title} — Bee`}
  description={text.title}
  noindex
>
  <StoreHeader locale={locale} />
  <main id="main">
    <PageTop title={text.title} text={text.note} />
    <div class="container">
      <CartWorkspace client:load locale={locale} />
    </div>
  </main>
  <StoreFooter locale={locale} />
</Layout>
