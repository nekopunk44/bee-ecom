---
import Layout from '../../layouts/Layout.astro';
import StoreHeader from '../../components/StoreHeader.astro';
import StoreFooter from '../../components/StoreFooter.astro';
import ProductTile from '../../components/ProductTile.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import HiveStory from '../../components/HiveStory.astro';
import { isLocale, messages } from '../../i18n';
import { catalogApi, type Metadata, type Product } from '../../lib/catalog';
const locale = Astro.params.locale;
if (!isLocale(locale)) return Astro.redirect('/404');
const t = messages[locale];
let categories: Metadata['categories'] = [];
let fresh: Product[] = [];
try {
  const api = catalogApi();
  const [references, products] = await Promise.all([
    api.GET('/api/v1/catalog/metadata', {
      params: { query: { locale } },
      signal: AbortSignal.timeout(3000),
    }),
    api.GET('/api/v1/products', {
      params: { query: { locale, sort: 'newest', page: 1, limit: 4 } },
      signal: AbortSignal.timeout(3000),
    }),
  ]);
  categories = references.data?.categories ?? [];
  fresh = products.data?.items ?? [];
} catch {
  // Главная остаётся рабочей и без каталога: первый экран, поиск и подвал не зависят от API.
}
const catalog = `/${locale}/catalog/`;
---

<Layout locale={locale} title={t.title} description={t.description}>
  <StoreHeader locale={locale} />
  <main id="main">
    <section class="story" data-story aria-labelledby="hero-heading">
      <div class="story-stage" data-story-stage aria-hidden="true">
        <HiveStory labels={t.parts} />
      </div>
      <div class="story-step hero">
        <div class="container hero-inner">
          <div class="hero-text">
            <p class="label rise">{t.label}</p>
            <h1 id="hero-heading" class="display rise" style="--delay: 90ms">
              {t.heading}
            </h1>
            <p class="intro rise" style="--delay: 200ms">
              {t.intro}
            </p>
            <div class="hero-actions rise" style="--delay: 300ms">
              <a class="button honey" href={catalog}>
                {t.open}
              </a>
            </div>
            <div class="queries rise" style="--delay: 380ms">
              <span>{t.popular}:</span>
              <ul>
                {t.queries.map((query) => (
                  <li>
                    <a href={`${catalog}?q=${encodeURIComponent(query)}`}>
                      {query}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <p class="notice rise" style="--delay: 460ms">
              {t.notice}
            </p>
          </div>
          <svg
            class="art rise"
            style="--delay: 160ms"
            width="520"
            height="500"
            viewBox="0 0 520 500"
            role="img"
            aria-label={t.art}
          >
            <g class="far" fill="none" stroke="#3a3628" stroke-width="2">
              <polygon
                class="drift a"
                points="90,40 142,70 142,130 90,160 38,130 38,70"
              ></polygon>
              <polygon
                class="drift b"
                points="430,300 482,330 482,390 430,420 378,390 378,330"
              ></polygon>
              <polygon
                class="drift c"
                points="455,90 507,120 507,180 455,210 403,180 403,120"
              ></polygon>
              <polygon
                class="drift d"
                points="60,330 112,360 112,420 60,450 8,420 8,360"
              ></polygon>
            </g>
            <polygon
              class="far glow"
              points="455,90 507,120 507,180 455,210 403,180 403,120"
              fill="#f5b700"
              opacity="0.18"
            ></polygon>
            <g class="near">
              <polygon
                class="comb"
                points="260,30 445,137 445,353 260,460 75,353 75,137"
                fill="#f5b700"
              ></polygon>
              <g
                class="hive"
                stroke="#17150f"
                stroke-width="5"
                stroke-linejoin="round"
                stroke-linecap="round"
              >
                <path d="M160 168 L260 138 L360 168 Z" fill="#ffffff"></path>
                <rect
                  x="168"
                  y="168"
                  width="184"
                  height="36"
                  fill="#17150f"
                ></rect>
                <rect
                  x="172"
                  y="204"
                  width="176"
                  height="78"
                  fill="#ffffff"
                ></rect>
                <rect
                  x="172"
                  y="282"
                  width="176"
                  height="78"
                  fill="#ffffff"
                ></rect>
                <path d="M232 243 h56 M232 321 h56" fill="none"></path>
                <rect
                  x="166"
                  y="360"
                  width="188"
                  height="16"
                  fill="#17150f"
                ></rect>
                <path d="M228 368 h64" stroke="#f5b700"></path>
                <path d="M184 376 v34 M336 376 v34" fill="none"></path>
              </g>
            </g>
            <g class="bee">
              <g class="bee-body">
                <ellipse
                  cx="396"
                  cy="232"
                  rx="13"
                  ry="9"
                  fill="#17150f"
                ></ellipse>
                <ellipse
                  class="wing"
                  cx="386"
                  cy="222"
                  rx="8"
                  ry="5"
                  fill="#ffffff"
                  opacity="0.9"
                ></ellipse>
              </g>
            </g>
          </svg>
        </div>
      </div>
      {([t.systems, t.frames] as const).map((chapter) => (
        <div class="story-step chapter">
          <div class="container chapter-inner">
            <p class="label">{chapter.label}</p>
            <h2 class="display">{chapter.title}</h2>
            <p class="chapter-text">{chapter.text}</p>
            {'list' in chapter ? (
              <ul class="systems">
                {chapter.list.map((system) => (
                  <li data-reveal>
                    <a
                      class:list={['system', { model: system.model }]}
                      href={`${catalog}?q=${encodeURIComponent(system.query)}`}
                    >
                      <span class="system-name">{system.name}</span>
                      {system.lines.map((line) => (
                        <span class="system-line">{line}</span>
                      ))}
                      {system.model && (
                        <span class="system-tag">{chapter.model}</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <a
                class="chapter-link"
                href={`${catalog}?q=${encodeURIComponent(chapter.query)}`}
              >
                {chapter.link}
              </a>
            )}
            {chapter === t.frames && fresh.length > 0 && (
              <section class="fresh" aria-labelledby="fresh-heading">
                <div class="fresh-head">
                  <h3 id="fresh-heading">{t.fresh}</h3>
                  <a href={catalog}>{t.all}</a>
                </div>
                <ul class="fresh-list">
                  {fresh.map((product) => (
                    <li data-reveal>
                      <ProductTile product={product} locale={locale} />
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        </div>
      ))}
      <div class="story-step finale">
        <div class="container finale-inner">
          <p class="label">{t.findEyebrow}</p>
          <h2 id="find-heading" class="display">
            {t.find}
          </h2>
          <p class="chapter-text">{t.findText}</p>
          <form class="search" method="get" action={catalog} role="search">
            <label class="visually-hidden" for="find-query">
              {t.findLabel}
            </label>
            <input
              id="find-query"
              name="q"
              type="search"
              maxlength="200"
              required
              placeholder={t.findPlaceholder}
            />
            <button class="button honey" type="submit">
              {t.findButton}
            </button>
          </form>
        </div>
      </div>
    </section>

    <section class="container block" aria-labelledby="catalog-heading">
      <div class="block-head" data-reveal>
        <h2 id="catalog-heading" class="display">
          {t.catalog}
        </h2>
        <a href={catalog}>{t.all}</a>
      </div>
      {categories.length > 0 ? (
        <ul class="categories">
          {categories.map((category) => (
            <li data-reveal>
              <a href={`${catalog}?category=${category.id}`}>
                <CategoryIcon slug={category.slug} />
                <span>{category.name}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <ul class="categories">
          <li>
            <a href={catalog}>
              <CategoryIcon slug="" />
              <span>{t.all}</span>
            </a>
          </li>
        </ul>
      )}
    </section>

    <div class="container block facts">
      {t.facts.map((fact) => (
        <section data-reveal>
          <h2 class="display">{fact.title}</h2>
          <p>{fact.text}</p>
        </section>
      ))}
    </div>
  </main>
  <StoreFooter locale={locale} />
</Layout>
<style>
  /* История главной. Без 3D это обычные блоки на графитовой полосе: первый экран с
     картинкой, две главы и поиск. С 3D (класс story--live ставит HiveStory) сцена
     прилипает к экрану, а шаги проезжают поверх неё: улей, его части, рамка, соты. */
  .story {
    position: relative;
    background: var(--color-night);
    color: #ffffff;
    --color-focus: var(--color-honey);
  }
  .story-stage {
    display: none;
  }
  .chapter {
    padding-block: var(--space-xl);
    border-top: 1px solid var(--color-night-line);
  }
  .chapter-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
    justify-items: start;
  }
  .chapter .label {
    margin: 0;
  }
  .chapter h2 {
    margin: 0;
    max-width: 20ch;
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .chapter-text {
    max-width: 34rem;
    margin: 0;
    color: var(--color-night-text);
    font-size: var(--text-lead);
  }
  .chapter-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-honey);
    font-weight: 700;
  }
  /* Системы ульев в главе о совместимости: та, что показана на модели, отмечена. */
  .systems {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
    gap: var(--space-sm);
    width: min(100%, 38rem);
    margin: var(--space-sm) 0 0;
    padding: 0;
    list-style: none;
  }
  .system {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.3rem;
    height: 100%;
    padding: var(--space-md);
    border: 1px solid var(--color-night-line);
    border-radius: var(--radius-md);
    background: rgb(42 39 32 / 0.88);
    color: var(--color-night-text);
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      transform var(--motion-normal) var(--ease-out),
      border-color var(--motion-normal) var(--ease-out);
  }
  .system:hover {
    transform: translateY(-3px);
    border-color: var(--color-honey);
  }
  .system.model {
    border-color: var(--color-honey);
  }
  .system-name {
    margin-bottom: 0.2rem;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .system-tag {
    justify-self: start;
    margin-top: 0.35rem;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    background: var(--color-honey);
    color: var(--color-ink);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .fresh {
    display: grid;
    gap: var(--space-sm);
    width: min(100%, 40rem);
    margin-top: var(--space-sm);
  }
  .fresh-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
  }
  .fresh-head h3 {
    margin: 0;
    color: var(--color-night-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .fresh-head a {
    color: #ffffff;
    font-weight: 600;
  }
  .fresh-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .finale {
    padding-block: var(--space-xl) var(--space-2xl);
  }
  .finale-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
    justify-items: start;
  }
  .finale .label {
    margin: 0;
  }
  .finale h2 {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2rem, 4.4vw, 3.5rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  /* Одна строка поиска: поле и кнопка в общей капсуле. */
  .search {
    display: flex;
    gap: var(--space-xs);
    width: min(100%, 36rem);
    margin-top: var(--space-sm);
    padding: 0.4rem;
    border-radius: var(--radius-pill);
    background: #ffffff;
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 35%);
  }
  .search:focus-within {
    outline: 3px solid var(--color-honey);
    outline-offset: 3px;
  }
  .search input {
    flex: 1;
    min-width: 0;
    padding-inline: 1.1rem;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-size: 1.125rem;
  }
  .search input:focus-visible {
    outline: none;
  }
  .search .button {
    min-height: 3.25rem;
    padding-inline: 1.75rem;
  }
  .story--live .story-stage {
    display: block;
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    pointer-events: none;
  }
  /* Шаги наезжают на сцену отрицательным отступом первого шага. Отрицательный
     отступ у самой сцены позволял ей выйти за низ секции и закрыть каталог. */
  .story--live .story-stage + .story-step {
    margin-top: -100vh;
    margin-top: -100svh;
  }
  .story--live .story-step {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: var(--space-xl);
    border: 0;
    background: none;
  }
  /* Затемнение под текстом лежит на самой сцене, одно на всю историю: у каждого шага
     было своё, и на границе шагов получался шов. К сотам оно плавно густеет. */
  .story--live .story-stage::before,
  .story--live .story-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .story--live .story-stage::before {
    background: linear-gradient(
      90deg,
      rgb(23 21 15 / 0.72),
      rgb(23 21 15 / 0) 55%
    );
  }
  .story--live .story-stage::after {
    opacity: var(--story-dive, 0);
    background: linear-gradient(
      90deg,
      rgb(23 21 15 / 0.94) 0%,
      rgb(23 21 15 / 0.8) 38%,
      rgb(23 21 15 / 0) 68%
    );
  }
  .story--live .art {
    display: none;
  }
  .story--live .hero-text {
    flex: 0 1 40rem;
  }
  @media (max-width: 47.99rem) {
    /* На телефоне сцена сверху; затемнение с мягкими краями только под текстом. */
    .story--live .story-step {
      align-items: flex-start;
      padding-top: 46svh;
      background: none;
    }
    .story--live .story-stage::before,
    .story--live .story-stage::after {
      display: none;
    }
    .search input {
      padding-inline: 0.9rem;
      font-size: 1rem;
    }
    .search .button {
      padding-inline: 1.25rem;
    }
    .story--live .story-step > .container {
      position: relative;
      z-index: 0;
    }
    .story--live .story-step > .container::before {
      content: '';
      position: absolute;
      inset: -3rem calc(-1 * var(--space-md)) -2rem;
      z-index: -1;
      background: linear-gradient(
        180deg,
        rgb(23 21 15 / 0) 0,
        rgb(23 21 15 / 0.9) 3rem,
        rgb(23 21 15 / 0.9) calc(100% - 2rem),
        rgb(23 21 15 / 0) 100%
      );
    }
  }
  .hero {
    background: var(--color-night);
    color: #ffffff;
    overflow: hidden;
    --color-focus: var(--color-honey);
  }
  .hero-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--space-xl) var(--space-2xl);
  }
  .hero-text {
    flex: 1 1 32rem;
    min-width: 0;
  }
  .label {
    margin: 0 0 var(--space-md);
    color: var(--color-honey);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    max-width: 15ch;
    font-size: var(--text-title);
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .intro {
    max-width: 36rem;
    margin: var(--space-lg) 0 0;
    color: var(--color-night-text);
    font-size: var(--text-lead);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
  .hero-actions .button {
    padding-inline: 2rem;
    min-height: 3.5rem;
    font-size: 1.125rem;
  }
  .queries {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
    color: var(--color-night-muted);
    font-size: var(--text-sm);
  }
  .queries ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .queries a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 1.1rem;
    border-radius: var(--radius-pill);
    background: var(--color-night-raised);
    color: #ffffff;
    font-weight: 600;
    text-decoration: none;
  }
  .queries a:hover {
    background: #ffffff;
    color: var(--color-ink);
  }
  .notice {
    max-width: 36rem;
    margin: var(--space-lg) 0 0;
    padding-left: var(--space-md);
    border-left: 3px solid var(--color-honey);
    color: var(--color-night-muted);
    font-size: var(--text-sm);
  }
  .art {
    flex: 1 1 22rem;
    max-width: min(100%, 32rem);
    height: auto;
    margin-inline: auto;
  }
  /* Иллюстрация живёт: соты дрейфуют, улей дышит, вокруг летает пчела.
     Каждая петля кончается там, где началась, чтобы при reduced motion всё стояло на месте. */
  .art * {
    transform-box: fill-box;
    transform-origin: center;
  }
  /* При прокрутке дальние соты уходят быстрее ближних — глубина без JavaScript. */
  @supports (animation-timeline: scroll()) {
    .far,
    .near,
    .bee {
      animation: linear both;
      animation-timeline: scroll(root);
      animation-range: 0 90vh;
    }
    .far {
      animation-name: depth-far;
    }
    .near {
      animation-name: depth-near;
    }
    .bee {
      animation-name: depth-bee;
    }
  }
  @keyframes depth-far {
    to {
      translate: 0 -70px;
    }
  }
  @keyframes depth-near {
    to {
      translate: 0 -24px;
    }
  }
  @keyframes depth-bee {
    to {
      translate: -40px -120px;
    }
  }
  .drift {
    animation: drift 9s var(--ease-in-out) infinite;
  }
  .drift.b {
    animation-duration: 11s;
    animation-delay: -3s;
  }
  .drift.c {
    animation-duration: 8s;
    animation-delay: -5s;
  }
  .drift.d {
    animation-duration: 12s;
    animation-delay: -1s;
  }
  @keyframes drift {
    50% {
      transform: translate(6px, -12px) rotate(8deg);
    }
  }
  .glow {
    animation: glow 5s var(--ease-in-out) infinite;
  }
  @keyframes glow {
    50% {
      opacity: 0.4;
    }
  }
  .comb {
    animation: breathe 7s var(--ease-in-out) infinite;
  }
  @keyframes breathe {
    50% {
      transform: scale(1.018);
    }
  }
  .hive {
    animation: bob 7s var(--ease-in-out) infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(-6px);
    }
  }
  .bee-body {
    animation: flight 11s var(--ease-in-out) infinite;
  }
  @keyframes flight {
    18% {
      transform: translate(46px, -44px) rotate(16deg);
    }
    36% {
      transform: translate(-6px, -112px) rotate(-10deg);
    }
    54% {
      transform: translate(-96px, -70px) rotate(-24deg);
    }
    74% {
      transform: translate(-40px, 36px) rotate(10deg);
    }
  }
  .wing {
    transform-origin: center bottom;
    animation: flutter 120ms linear infinite;
  }
  @keyframes flutter {
    50% {
      transform: scaleY(0.3);
    }
  }
  .block {
    padding-top: var(--space-2xl);
  }
  .block-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-sm) var(--space-lg);
  }
  .block-head h2 {
    margin: 0;
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    letter-spacing: -0.035em;
  }
  .block-head p {
    margin: 0;
    color: var(--color-muted);
  }
  .block-head a {
    font-weight: 700;
  }
  .categories {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0 var(--space-xl);
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--color-ink);
  }
  .categories li {
    display: flex;
  }
