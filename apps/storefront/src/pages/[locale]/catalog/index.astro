---
import Layout from '../../../layouts/Layout.astro';
import StoreHeader from '../../../components/StoreHeader.astro';
import StoreFooter from '../../../components/StoreFooter.astro';
import ProductCard from '../../../components/ProductCard.astro';
import CombField from '../../../components/CombField.astro';
import CategoryIcon from '../../../components/CategoryIcon.astro';
import FilterIcon from '../../../components/FilterIcon.astro';
import PriceFilter from '../../../components/PriceFilter.astro';
import { isLocale } from '../../../i18n';
import { catalogApi, catalogText } from '../../../lib/catalog';
import { priceParam } from '../../../lib/price-scale';
import type { components } from '@bee/api-client';
const locale = Astro.params.locale;
if (!isLocale(locale)) return Astro.redirect('/404');
const t = catalogText[locale];
const params = Astro.url.searchParams;
const sortValues = ['newest', 'price_asc', 'price_desc', 'name'] as const;
const rawSort = params.get('sort') ?? 'newest';
const sort = sortValues.find((value) => value === rawSort) ?? 'newest';
const page = Math.max(1, Math.min(10000, Number(params.get('page')) || 1));
// Цена в адресе может прийти с пробелами («1 000») или с границами наоборот.
let minPrice = priceParam(params.get('min'));
let maxPrice = priceParam(params.get('max'));
if (minPrice && maxPrice && Number(minPrice) > Number(maxPrice))
  [minPrice, maxPrice] = [maxPrice, minPrice];
let data: components['schemas']['ProductPage'] | undefined;
let metadata: components['schemas']['Metadata'] | undefined;
let failed = false;
try {
  const api = catalogApi();
  const [products, references] = await Promise.all([
    api.GET('/api/v1/products', {
      params: {
        query: {
          locale,
          q: params.get('q') ?? '',
          category: params.get('category') ?? '',
          brand: params.get('brand') ?? '',
          sort,
          page,
          limit: 12,
          ...(minPrice ? { minPrice: Number(minPrice) * 100 } : {}),
          ...(maxPrice ? { maxPrice: Number(maxPrice) * 100 } : {}),
        },
      },
      signal: AbortSignal.timeout(5000),
    }),
    api.GET('/api/v1/catalog/metadata', {
      params: { query: { locale } },
      signal: AbortSignal.timeout(5000),
    }),
  ]);
  data = products.data;
  metadata = references.data;
  failed = !data || !metadata;
  if (failed)
    Astro.response.status = products.response.status === 400 ? 400 : 503;
} catch {
  failed = true;
  Astro.response.status = 503;
}
const pageLink = (value: number) => {
  const query = new URLSearchParams(params);
  query.set('page', String(value));
  return `?${query}`;
};
const pages = Math.max(1, Math.ceil((data?.total ?? 0) / 12));
// На телефоне фильтры свёрнуты, но открыты сразу, если покупатель уже что-то выбрал.
const refined =
  ['category', 'brand', 'min', 'max'].some((key) => params.get(key)) ||
  sort !== 'newest';
/** Та же выдача с другими параметрами; номер страницы сбрасывается на первую. */
const link = (changes: Record<string, string | null>) => {
  const query = new URLSearchParams(params);
  query.delete('page');
  for (const [key, value] of Object.entries(changes)) {
    if (value) query.set(key, value);
    else query.delete(key);
  }
  for (const [key, value] of [...query]) if (!value) query.delete(key);
  const text = query.toString();
  return text ? `?${text}` : `/${locale}/catalog/`;
};
const lei = new Intl.NumberFormat(locale === 'ro' ? 'ro-MD' : 'ru-MD', {
  maximumFractionDigits: 0,
});
const priceLabel = (min: string | null, max: string | null) =>
  min && max
    ? `${lei.format(Number(min))}–${lei.format(Number(max))} L`
    : min
      ? `${t.from} ${lei.format(Number(min))} L`
      : `${t.upTo} ${lei.format(Number(max ?? 0))} L`;
const quote = (text: string) => (locale === 'ro' ? `„${text}”` : `«${text}»`);
const currentCategory = metadata?.categories.find(
  (c) => c.id === params.get('category'),
);
const currentBrand = metadata?.brands.find((b) => b.id === params.get('brand'));
// Выбранные фильтры чипами над товарами: каждый убирается своей ссылкой.
const chips = [
  params.get('q') && {
    label: quote(params.get('q') ?? ''),
    href: link({ q: null }),
  },
  currentCategory && {
    label: currentCategory.name,
    href: link({ category: null }),
  },
  currentBrand && { label: currentBrand.name, href: link({ brand: null }) },
  (minPrice || maxPrice) && {
    label: priceLabel(minPrice, maxPrice),
    href: link({ min: null, max: null }),
  },
].filter((chip): chip is { label: string; href: string } => Boolean(chip));
const facets = data?.facets;
// Сколько товаров даст каждый выбор. Без сводки от API числа не показываются.
const counts = new Map(
  [...(facets?.categories ?? []), ...(facets?.brands ?? [])].map((facet) => [
    facet.id,
    facet.count,
  ]),
);
const countOf = (id: string) => (facets ? (counts.get(id) ?? 0) : undefined);
---

<Layout
  locale={locale}
  title={`${t.catalog} — Bee`}
  description={t.title}
  noindex={params.size > 0}
>
  <StoreHeader locale={locale} />
  <main id="main" class="container">
    <div class="heading">
      <p class="eyebrow rise">{t.catalog}</p>
      <h1 class="display rise" data-step="1">
        {t.title}
      </h1>
    </div>
    <div class="layout">
      <form class="filters" method="get" role="search" data-filters>
        <input
          id="filters-open"
          class="filters-open visually-hidden"
          type="checkbox"
          checked={refined}
        />
        {params.get('q') && (
          <input type="hidden" name="q" value={params.get('q') ?? ''} />
        )}
        <div class="filters-head">
          <p class="filters-title">
            {t.filters}
            {chips.length > 0 && <b>{chips.length}</b>}
          </p>
          {chips.length > 0 && (
            <a
              class="reset"
              href={`/${locale}/catalog/`}
              aria-label={t.clearAll}
              title={t.clearAll}
            >
              <FilterIcon name="reset" />
            </a>
          )}
        </div>
        <div class="filters-top">
          <label for="filters-open" class="filters-toggle">
            <FilterIcon name="sliders" />
            <span>{t.filters}</span>
            {chips.length > 0 && <b>{chips.length}</b>}
          </label>
        </div>
        <div class="filters-panel">
          <fieldset class="group">
            <legend>{t.category}</legend>
            <div class="options">
              {metadata?.categories.map((c) => {
                const count = countOf(c.id);
                return (
                  <label
                    class="option"
                    data-empty={count === 0 ? '' : undefined}
                  >
                    <input
                      class="visually-hidden"
                      type="radio"
                      name="category"
                      value={c.id}
                      checked={params.get('category') === c.id}
                    />
                    <span class="cell">
                      <CategoryIcon slug={c.slug} />
                    </span>
                    <span class="name">{c.name}</span>
                    <FilterIcon name="clear" />
                  </label>
                );
              })}
            </div>
          </fieldset>
          <PriceFilter
            locale={locale}
            min={minPrice}
            max={maxPrice}
            price={facets?.price}
            text={{
              legend: t.priceRange,
              min: t.min,
              max: t.max,
              from: t.from,
              upTo: t.upTo,
              lower: t.lower,
              upper: t.upper,
            }}
          />
          {(metadata?.brands.length ?? 0) > 0 && (
            <fieldset class="group">
              <legend>{t.brand}</legend>
              <div class="options">
                {metadata?.brands.map((b) => {
                  const count = countOf(b.id);
                  return (
                    <label
                      class="option"
                      data-empty={count === 0 ? '' : undefined}
                    >
                      <input
                        class="visually-hidden"
                        type="radio"
                        name="brand"
                        value={b.id}
                        checked={params.get('brand') === b.id}
                      />
                      <span class="cell mark" aria-hidden="true" />
                      <span class="name">{b.name}</span>
                      <FilterIcon name="clear" />
                    </label>
                  );
                })}
              </div>
            </fieldset>
          )}
          {sort !== 'newest' && (
            <input type="hidden" name="sort" value={sort} />
          )}
          <div class="actions">
            {chips.length > 0 && (
              <a
                class="reset"
                href={`/${locale}/catalog/`}
                aria-label={t.clearAll}
                title={t.clearAll}
              >
                <FilterIcon name="reset" />
              </a>
            )}
            <button
              class="button honey"
              type="submit"
              data-apply
              data-locale={locale}
              data-count-zero={t.countZero}
              data-count-one={t.countOne}
              data-count-few={t.countFew}
              data-count-many={t.countMany}
              data-count-other={t.countOther}
            >
              {t.apply}
            </button>
          </div>
        </div>
      </form>
      <div class="results">
        <div class="results-bar">
          <div class="summary">
            {!failed && (
              <p class="found">
                {t.found}: <strong>{data?.total}</strong>
              </p>
            )}
            {chips.length > 0 && (
              <ul class="chips" aria-label={t.activeFilters}>
                {chips.map((chip) => (
                  <li>
                    <a
                      href={chip.href}
                      aria-label={`${t.remove}: ${chip.label}`}
                    >
                      {chip.label}
                      <span aria-hidden="true">×</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
          {!failed && (
            <nav class="sorting" aria-label={t.sort}>
              {sortValues.map((value) => (
                <a
                  href={link({ sort: value === 'newest' ? null : value })}
                  aria-current={value === sort ? 'true' : undefined}
                >
                  {t[value]}
                </a>
              ))}
            </nav>
          )}
        </div>
        {failed ? (
          <div class="state" role="status">
            {t.unavailable}
          </div>
        ) : (
          <>
            {data?.items.length ? (
              <div class="products" data-catalog-results>
                {data.items.map((product) => (
                  <ProductCard product={product} locale={locale} reveal />
                ))}
              </div>
            ) : (
              <div class="state">
                <CombField />
                <p>{t.empty}</p>
                <a class="button ghost" href={`/${locale}/catalog/`}>
                  {t.clear}
                </a>
              </div>
            )}
            {pages > 1 && (
              <nav class="pagination" aria-label={t.catalog}>
                {page > 1 && <a href={pageLink(page - 1)}>{t.previous}</a>}
                <span>
                  {page} / {pages}
                </span>
                {page < pages && <a href={pageLink(page + 1)}>{t.next}</a>}
              </nav>
            )}
          </>
        )}
      </div>
    </div>
  </main>
  <StoreFooter locale={locale} />
</Layout>
<script>
  /* Категория и бренд применяются сразу: мёд заливает ячейку, и через 0,4 с
     открывается выдача. Повторное нажатие на выбранную строку снимает выбор. Цена —
     по кнопке, но кнопка заранее показывает, сколько товаров найдётся. Пустые поля
     не отправляются, чтобы адрес выдачи оставался коротким. Без JavaScript работает
     кнопка «Показать товары», а выбор снимается крестиком на чипе. */
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  for (const form of document.querySelectorAll<HTMLFormElement>(
    'form[data-filters]',
  )) {
    const button = form.querySelector<HTMLButtonElement>('[data-apply]');
    const locale = button?.dataset.locale ?? 'ru';
    const numbers = new Intl.NumberFormat(locale);
    let timer: number | undefined;
    const apply = () => {
      clearTimeout(timer);
      timer = window.setTimeout(
        () => form.requestSubmit(),
        still.matches ? 0 : 400,
      );
    };

    // Нажатие на уже выбранную строку: на pointerdown радиокнопка ещё помнит, что
    // была выбрана. С клавиатуры выбор так не снимается, для этого есть чипы.
    let pressed: HTMLInputElement | null = null;
    form.addEventListener('pointerdown', (event) => {
      const input =
        event.target instanceof Element
          ? event.target
              .closest('.option')
              ?.querySelector<HTMLInputElement>('input[type="radio"]')
          : null;
      pressed = input?.checked ? input : null;
    });
    form.addEventListener('click', (event) => {
      const input = event.target;
      if (
        input instanceof HTMLInputElement &&
        input.type === 'radio' &&
        input === pressed
      ) {
        pressed = null;
        input.checked = false;
        apply();
      }
    });

    // Число на кнопке докручивается до нового значения.
    let shown: number | undefined;
    const show = (total: number) => {
      const rule =
        total === 0 ? 'zero' : new Intl.PluralRules(locale).select(total);
      const key = `count${rule.charAt(0).toUpperCase()}${rule.slice(1)}`;
      const template = button?.dataset[key] ?? button?.dataset.countOther ?? '';
      const from = shown ?? total;
      shown = total;
      if (!button) return;
      if (still.matches || from === total) {
        button.textContent = template.replace('{n}', numbers.format(total));
        return;
      }
      const start = performance.now();
      const step = (now: number) => {
        const progress = Math.min(1, (now - start) / 420);
        const value = Math.round(
          from + (total - from) * (1 - (1 - progress) ** 3),
        );
        button.textContent = template.replace('{n}', numbers.format(value));
        if (progress < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
      button.animate([{ scale: 1 }, { scale: 1.04 }, { scale: 1 }], {
        duration: 320,
        easing: 'ease-out',
      });
    };
    let pending: AbortController | undefined;
    const recount = async () => {
      if (!button) return;
      pending?.abort();
      const current = (pending = new AbortController());
      const fields = new FormData(form);
      const value = (key: string) => String(fields.get(key) ?? '').trim();
      const lei = (key: string) => value(key).replace(/\D/g, '');
      const query = new URLSearchParams({ locale, limit: '1' });
      for (const key of ['q', 'category', 'brand'])
        if (value(key)) query.set(key, value(key));
      if (lei('min')) query.set('minPrice', String(Number(lei('min')) * 100));
      if (lei('max')) query.set('maxPrice', String(Number(lei('max')) * 100));
      try {
        const response = await fetch(`/api/v1/products?${query}`, {
          signal: current.signal,
        });
        if (!response.ok) return;
        const { total } = (await response.json()) as { total: number };
        show(total);
      } catch {
        // Нет связи с API: на кнопке остаётся «Показать товары».
      }
    };

    form.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      if (target.type === 'radio') apply();
      else if (target.closest('[data-price]')) void recount();
    });
    form.addEventListener('submit', (event) => {
      // Прокрутку панели восстановит public/view-transition.js на новой странице.
      try {
        sessionStorage.setItem('bee:filters-scroll', String(form.scrollTop));
      } catch {
        // Без sessionStorage панель откроется сверху.
      }
      for (const field of form.querySelectorAll<HTMLInputElement>(
        'input[name="min"], input[name="max"]',
      ))
        field.value = field.value.replace(/\D/g, '');
      for (const field of form.querySelectorAll<HTMLInputElement>(
        'input[name]',
      ))
        if (!field.value && (field.type !== 'radio' || field.checked))
          field.disabled = true;
      // Ничего не выбрано: чистый адрес каталога вместо «/catalog/?».
      if ([...new FormData(form)].length === 0) {
        event.preventDefault();
        location.assign(location.pathname);
      }
    });
  }
  // Назад из выдачи: поля снова доступны, если страница вернулась из кэша.
  window.addEventListener('pageshow', () => {
    for (const field of document.querySelectorAll<HTMLInputElement>(
      'form[data-filters] input[disabled]',
    ))
      field.disabled = false;
  });
</script>
<style>
  main {
    padding-top: var(--space-xl);
  }
  .eyebrow {
    margin: 0 0 var(--space-sm);
  }
  h1 {
    margin: 0;
    max-width: 20ch;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  /* Панель фильтров. Выбранное в ней наливается мёдом: шестигранник категории
     заполняется снизу вверх, а строка становится графитовой. */
  .filters {
    display: grid;
    gap: var(--space-md);
    align-content: start;
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    background: var(--color-sand);
  }
  /* При переходе между выдачами панель стоит на месте, меняются только товары.
     При входе в каталог с другой страницы её не выделяем: каталог целиком
     раскрывается сотой. */
  :global(html:not([data-transition='catalog'])) .filters {
    view-transition-name: catalog-filters;
  }
  .filters-head {
    display: none;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    min-height: 2.5rem;
  }
  .filters-title {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .filters-title b,
  .filters-toggle b {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.7rem;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: var(--color-honey);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0;
  }
  /* Сброс — круглая кнопка со стрелкой; при наведении стрелка делает оборот. */
  .reset {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-paper);
    color: var(--color-ink);
    transition:
      background var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }
  .reset :global(.icon) {
    transition: rotate var(--motion-slow) var(--ease-standard);
  }
  .reset:hover {
    background: var(--color-ink);
    color: var(--color-honey);
  }
  .reset:hover :global(.icon) {
    rotate: -360deg;
  }
  .filters-top {
    display: flex;
    gap: var(--space-sm);
  }
  /* На телефоне фильтры открывает строка со значком: ползунки на нём разъезжаются. */
  .filters-toggle {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--space-sm);
    min-height: 3rem;
    margin: 0;
    padding-inline: 1rem;
    font-weight: 700;
    border-radius: var(--radius-pill);
    background: var(--color-paper);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background var(--motion-normal) var(--ease-standard),
      color var(--motion-normal) var(--ease-standard);
  }
  .filters-toggle :global(.knob) {
    fill: var(--color-paper);
    transition:
      translate var(--motion-normal) var(--ease-standard),
      fill var(--motion-normal) var(--ease-standard);
  }
  .filters-open:checked ~ .filters-top .filters-toggle {
    background: var(--color-ink);
    color: #ffffff;
  }
  .filters-open:checked ~ .filters-top .filters-toggle :global(.knob) {
    fill: var(--color-honey);
  }
  .filters-open:checked
    ~ .filters-top
    .filters-toggle
    :global(.knob:nth-of-type(1)) {
    translate: 7px 0;
  }
  .filters-open:checked
    ~ .filters-top
    .filters-toggle
    :global(.knob:nth-of-type(2)) {
    translate: -6px 0;
  }
  .filters-open:checked
    ~ .filters-top
    .filters-toggle
    :global(.knob:nth-of-type(3)) {
    translate: 5px 0;
  }
  .filters-open:focus-visible ~ .filters-top .filters-toggle {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }
  .filters-panel {
    display: none;
    gap: var(--space-md);
    opacity: 0;
    translate: 0 -0.5rem;
    transition:
      opacity var(--motion-normal) var(--ease-standard),
      translate var(--motion-normal) var(--ease-standard),
      display var(--motion-normal) allow-discrete;
  }
  .filters-open:checked ~ .filters-panel {
    display: grid;
    opacity: 1;
    translate: 0 0;
  }
  @media (max-width: 63.99rem) {
    @starting-style {
      .filters-open:checked ~ .filters-panel {
        opacity: 0;
        translate: 0 -0.5rem;
      }
    }
  }
  .group {
    display: grid;
    margin: 0;
    padding: var(--space-md) 0 0;
    border: 0;
    border-top: 1px solid var(--color-line);
  }
  .group legend {
    float: left;
    width: 100%;
    margin-bottom: var(--space-sm);
    padding: 0;
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .options {
    display: grid;
    gap: 0.2rem;
  }
  .option {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 2.75rem;
    margin: 0;
    padding: 0.3rem 0.8rem 0.3rem 0.35rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    line-height: 1.25;
    cursor: pointer;
    transition:
      background var(--motion-normal) var(--ease-standard),
      color var(--motion-normal) var(--ease-standard);
  }
  .option .name {
    flex: 1;
    min-width: 0;
  }
  .option:hover {
    background: var(--color-paper);
  }
  .option:has(input:checked) {
    background: var(--color-ink);
    color: #ffffff;
  }
  .option[data-empty] {
    color: var(--color-muted);
  }
  .option[data-empty] .cell {
    opacity: 0.5;
  }
  .option:has(input:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
