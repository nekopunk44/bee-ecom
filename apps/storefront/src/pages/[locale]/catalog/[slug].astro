---
import Layout from '../../../layouts/Layout.astro';
import StoreHeader from '../../../components/StoreHeader.astro';
import StoreFooter from '../../../components/StoreFooter.astro';
import HexMark from '../../../components/HexMark.astro';
import AddToCart from '../../../components/AddToCart.svelte';
import { isLocale } from '../../../i18n';
import { demoPhotos } from '../../../lib/photo-credits';
import {
  catalogApi,
  catalogText,
  money,
  type Product,
  type Metadata,
} from '../../../lib/catalog';
const locale = Astro.params.locale;
if (!isLocale(locale)) return Astro.redirect('/404');
const t = catalogText[locale];
let product: Product | undefined;
let metadata: Metadata | undefined;
let missing = false;
try {
  const api = catalogApi();
  const [response, references] = await Promise.all([
    api.GET('/api/v1/products/{slug}', {
      params: { path: { slug: Astro.params.slug ?? '' } },
      signal: AbortSignal.timeout(5000),
    }),
    api.GET('/api/v1/catalog/metadata', {
      params: { query: { locale } },
      signal: AbortSignal.timeout(5000),
    }),
  ]);
  product = response.data;
  metadata = references.data;
  missing = response.response.status === 404;
  if (!product) Astro.response.status = missing ? 404 : 503;
} catch {
  Astro.response.status = 503;
}
const translation = product?.translations[locale];
const hero = product?.images[0];
// Свободные фото демо-каталога подписываются автором и лицензией прямо под снимком.
const credits = product ? (demoPhotos[product.slug] ?? []) : [];
const variants = product?.variants.filter((v) => v.active) ?? [];
const single = variants.length === 1;
const lowest = Math.min(...variants.map((v) => v.priceMinor));
const attribute = (code: string) =>
  metadata?.attributes.find((a) => a.code === code);
const label =
  metadata?.brands.find((b) => b.id === product?.brandId)?.name ??
  metadata?.categories.find((c) => product?.categoryIds.includes(c.id))?.name ??
  'Bee';
const title =
  translation?.seoTitle ||
  translation?.name ||
  (missing ? t.missing : t.unavailable);
const structured = product
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: translation?.name,
      description: translation?.description,
      sku: product.variants[0]?.sku,
      image: product.images.map((i) => new URL(i.url, Astro.site).href),
      offers: product.variants.map((v) => ({
        '@type': 'Offer',
        price: (v.priceMinor / 100).toFixed(2),
        priceCurrency: 'MDL',
        url: new URL(Astro.url.pathname, Astro.site).href,
      })),
      brand: metadata?.brands.find((b) => b.id === product?.brandId)?.name,
    }
  : null;
---

<Layout
  locale={locale}
  title={`${title} — Bee`}
  description={
    translation?.seoDescription ||
    translation?.description.slice(0, 160) ||
    title
  }
  noindex={!product}
>
  <StoreHeader locale={locale} />
  <main id="main" class="container">
    <nav class="crumbs" aria-label={t.catalog}>
      <a href={`/${locale}/catalog/`}>{t.catalog}</a>
      <span aria-hidden="true">/</span>
      <span>{translation?.name ?? title}</span>
    </nav>
    {product && translation ? (
      <>
        <div class="product">
          <div class="media">
            <div
              class:list={['hero', { empty: !hero }]}
              data-transition-name={`product-${product.slug}`}
            >
              {hero ? (
                <img
                  src={hero.url}
                  srcset={hero.srcSet}
                  sizes="(min-width: 64rem) 600px, 90vw"
                  alt={translation.name}
                  width="640"
                  height="640"
                  fetchpriority="high"
                />
              ) : (
                <span class="placeholder">
                  <HexMark size={72} />
                  {t.noImage}
                </span>
              )}
            </div>
            {product.images.length > 1 && (
              <ul class="gallery">
                {product.images.slice(1).map((image) => (
                  <li>
                    <a href={image.url}>
                      <img
                        src={image.url}
                        srcset={image.srcSet}
                        sizes="160px"
                        alt={translation.name}
                        width="160"
                        height="160"
                        loading="lazy"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            )}
            {credits.length > 0 && (
              <p class="credits">
                {t.photo}:{' '}
                {credits.map((credit, index) => (
                  <>
                    {index > 0 && ', '}
                    <a href={credit.page} rel="noopener" target="_blank">
                      {credit.author}
                    </a>{' '}
                    ({credit.license})
                  </>
                ))}
                , Wikimedia Commons
              </p>
            )}
          </div>
          <div class="buy">
            <p class="eyebrow rise">{label}</p>
            <h1 class="display rise" data-step="1">
              {translation.name}
            </h1>
            {variants.length > 0 && (
              <p class="price rise" data-step="2">
                {!single && <span>{t.from}</span>}
                {money(lowest, locale)}
              </p>
            )}
            <div class="variants rise" data-step="3">
              {variants.map((variant) => (
                <article class:list={['variant', { single }]}>
                  <div class="variant-head">
                    <h2>{variant.name}</h2>
                    {!single && (
                      <p class="variant-price">
                        {money(variant.priceMinor, locale)}
                      </p>
                    )}
                  </div>
                  <p class="sku">
                    {t.sku}: {variant.sku}
                  </p>
                  <AddToCart
                    variantId={variant.id}
                    locale={locale}
                    client:visible
                  />
                </article>
              ))}
            </div>
            <p class="notice rise" data-step="4">
              <HexMark size={22} />
              <span>{t.orderNotice}</span>
            </p>
          </div>
        </div>
        <div class="details" data-reveal>
          <section aria-labelledby="description-heading">
            <h2 id="description-heading" class="display">
              {t.description}
            </h2>
            <p class="description">{translation.description}</p>
          </section>
          {variants.some((v) => Object.keys(v.attributes).length > 0) && (
            <section aria-labelledby="specs-heading">
              <h2 id="specs-heading" class="display">
                {t.specs}
              </h2>
              {variants.map((variant) => (
                <dl>
                  {!single && <p class="group">{variant.name}</p>}
                  {Object.entries(variant.attributes).map(([code, value]) => (
                    <div>
                      <dt>{attribute(code)?.name ?? code}</dt>
                      <dd>
                        {value} {attribute(code)?.unit}
                      </dd>
                    </div>
                  ))}
                </dl>
              ))}
            </section>
          )}
        </div>
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structured).replace(/</g, '\u003c')}
        ></script>
      </>
    ) : (
      <section class="missing">
        <h1 class="display">{title}</h1>
        <a class="button" href={`/${locale}/catalog/`}>
          {t.back}
        </a>
      </section>
    )}
  </main>
  <StoreFooter locale={locale} />
</Layout>
<style>
  .credits {
    margin: var(--space-sm) 0 0;
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.4;
  }
  .credits a {
    color: inherit;
  }
  main {
    padding-top: var(--space-lg);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .product {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-lg);
  }
  .media,
  .buy {
    min-width: 0;
  }
  .hero {
    aspect-ratio: 1.05;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-sand);
  }
  .hero.empty {
    background: var(--color-honey-soft);
  }
  /* На телефоне фото не занимает весь первый экран: название и цена видны сразу. */
  @media (max-width: 63.99rem) {
    .hero {
      aspect-ratio: 4 / 3;
    }
  }
  .hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    color: var(--color-muted);
    font-weight: 600;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-sm);
    margin: var(--space-sm) 0 0;
    padding: 0;
    list-style: none;
  }
  .gallery a {
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
    background: var(--color-sand);
  }
  .gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .buy .eyebrow {
    margin: 0;
  }
  h1 {
    margin: var(--space-sm) 0 0;
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    overflow-wrap: anywhere;
  }
  .price {
    margin: var(--space-lg) 0 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .price span {
    margin-right: 0.3em;
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-muted);
  }
  .variants {
    display: grid;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
  .variant {
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    border: 2px solid var(--color-line);
    border-radius: var(--radius-md);
  }
  .variant.single {
    padding: 0;
    border: 0;
  }
  .variant-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-xs) var(--space-md);
  }
  .variant h2 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
  }
  .variant-price {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .sku {
    margin: var(--space-xs) 0 var(--space-md);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .notice {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    margin: var(--space-lg) 0 0;
    padding: var(--space-md);
    border-radius: var(--radius-md);
    background: var(--color-honey-soft);
    font-size: var(--text-sm);
  }
  .notice :global(svg) {
    flex: none;
    margin-top: 0.1rem;
  }
  .details {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-2xl);
  }
  .details h2 {
    margin: 0;
    font-size: clamp(1.625rem, 2.6vw, 2rem);
    letter-spacing: -0.03em;
  }
  .description {
    max-width: 40rem;
    margin: var(--space-md) 0 0;
    font-size: var(--text-lead);
    white-space: pre-line;
  }
  dl {
    margin: var(--space-md) 0 0;
    border-top: 2px solid var(--color-ink);
  }
  .group {
    margin: 0;
    padding-top: var(--space-md);
    font-weight: 700;
  }
  dl div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-line);
  }
  dt {
    color: var(--color-muted);
  }
  dd {
    margin: 0;
    font-weight: 700;
    text-align: right;
  }
  .missing {
    padding-block: var(--space-xl);
  }
  .missing h1 {
    margin-bottom: var(--space-lg);
  }
  @media (min-width: 64rem) {
    .product,
    .details {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--space-xl) calc(var(--space-xl) + var(--space-sm));
    }
    .product {
      align-items: start;
    }
  }
</style>
